# ===== 服务端代理 · 环境变量模板 =====
# 复制为 server/.env 后填入真实值；server/.env 已加入 .gitignore，切勿提交

# ---- 钉钉企业内部应用凭证（开发者后台 → 凭证与基础信息）----
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# ---- AI 表格定位（打开多维表格，从 URL 中取 baseId）----
DINGTALK_BASE_ID=

# ---- 系统操作人 unionId（对表格有编辑权限的账号，AI表格接口必带）----
DINGTALK_OPERATOR_ID=

# ---- 各数据表：填中文表名或 sheetId（与真实表一致即可，默认用中文表名）----
SHEET_WORK_ORDER=工单
SHEET_NODE_TEMPLATE=节点模板
SHEET_NODE=工单节点
SHEET_STUDENT=学生档案
SHEET_MATERIAL=材料清单
SHEET_ESSAY=文书素材
SHEET_PLAN=方案版本
SHEET_CHANGE=变更记录
SHEET_RULE_CARD=规则库
SHEET_CALIBER=口径库
SHEET_UNIVERSITY=重点院校清单
SHEET_MAJOR=专业库
SHEET_KEY_DATE=关键日期
SHEET_INTERVIEW=约谈记录
SHEET_ADMISSION=录取结果
SHEET_QA=家长问答
SHEET_NODE_HISTORY=节点留痕

# ---- 服务端 ----
PORT=8787
DINGTALK_API_BASE=https://api.dingtalk.com
